    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PUBLIC_CLERK_PROXY_URL= REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:video-watch-progress": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/video-watch-progress.test.mjs",
    "test:tournament-mode-filters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tournament-mode-filters.test.mjs",
    "test:tournament-join-recovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tournament-join-recovery.test.mjs",
