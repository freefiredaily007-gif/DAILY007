{
  "expo": {
    "name": "Daily007",
    "slug": "daily007",
    "version": "1.0.0",
    "platforms": ["android", "web"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily007",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daily007.app"
    },
    "android": {
      "package": "com.daily007.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
